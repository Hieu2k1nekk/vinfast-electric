# Domain chính thức (dùng cho canonical, sitemap, Open Graph). PLACEHOLDER — cần cập nhật.
NEXT_PUBLIC_SITE_URL=https://vinfast-electric.example.com

# Nơi nhận đăng ký từ form (/api/lead): Google Apps Script, n8n, Make, Zapier, CRM… nhận POST JSON.
# Bỏ trống → API trả 503 NOT_CONFIGURED và giao diện hướng khách gọi hotline / Zalo (không giả vờ gửi thành công).
# Đặt biến này TRƯỚC khi `npm run build` (trang được prerender).
LEAD_WEBHOOK_URL=
# Tùy chọn: gửi kèm header Authorization: Bearer <secret>
LEAD_WEBHOOK_SECRET=
